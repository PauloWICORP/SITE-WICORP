# Arquivos gerados pelo build — não versionar.
# São recriados por build.py e build-preview.py.
preview.html
prev-*.html

# Python
__pycache__/
*.pyc

# Sistema
.DS_Store
Thumbs.db
desktop.ini

# Editores
.vscode/*
!.vscode/extensions.json
.idea/
*.swp

# O pacote nao entra no repositorio: os arquivos ja estao aqui
wicorp-site.zip

# Conteudo publicado pelo painel — vive no servidor, nao no repositorio.
# Se isso entrar no Git, um "git pull" apaga novidade que esta no ar.
conteudo.json
!conteudo.exemplo.json
img/novidades/*
!img/novidades/LEIA-ME.txt

# Senha do painel
painel/config.json
.venv/

# Documento interno e pacote NAO entram no repositorio: tudo aqui e publico
# (o GitHub Pages publica qualquer arquivo). Roteiro de cliente, proposta,
# planilha e zip de atualizacao ficam fora — ver CLAUDE.md, "Onde cada arquivo mora".
*.pdf
*.zip
*.xlsx
*.xls
*.csv
*.docx
*.pptx
